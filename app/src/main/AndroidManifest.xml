        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StyleSyncAdmin">
        <activity
            android:name=".activity.ManageServicesActivity"
            android:exported="false" />
        <activity
            android:name=".activity.AddServiceActivity"
            android:exported="false" />
        <activity
            android:name=".activity.TodayBookingsActivity"
            android:exported="false" />
        <activity
            android:name=".activity.AllBookingsActivity"
            android:exported="false" />
        <activity
            android:name=".activity.AdminLoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.AdminMainActivity"
            android:exported="false">

            <!-- <intent-filter> -->
            <!-- <action android:name="android.intent.action.MAIN" /> -->


            <!-- <category android:name="android.intent.category.LAUNCHER" /> -->
            <!-- </intent-filter> -->
        </activity>
